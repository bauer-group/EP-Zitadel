# Env for the dev-only UI preview workflow (`pnpm ui-preview`).
# NOT secret — a placeholder backend URL just so the middleware (src/proxy.ts)
# does not throw, plus knobs to keep the preview self-contained and quiet.
ZITADEL_API_URL=http://localhost:8080
CSP_FETCH_ENABLED=false
# start-server-and-test waits this long (ms) for the first Turbopack compile.
WAIT_ON_TIMEOUT=180000
